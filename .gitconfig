[user]
  name = Lewis Steele
  email = lewis.steele@me.com
[core]
  editor = nvim
  pager = less --tabs 2 --mouse
[commit]
  gpgsign = true
[pull]
  rebase = false
[push]
  autoSetupRemote = true
  followTags = true
[init]
  defaultBranch = main
[tag]
  gpgSign = true
[gpg]
  program = /opt/homebrew/bin/gpg
[delta "catppuccin-dark"]
  syntax-theme = Catppuccin Mocha
  minus-style = syntax "#443244"
  minus-emph-style = syntax "#5a3d50"
  plus-style = syntax "#323c3f"
  plus-emph-style = syntax "#404f4b"
