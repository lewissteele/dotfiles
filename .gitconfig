[user]
  name = Lewis Steele
  email = lewis.steele@me.com
[core]
  editor = nvim
  pager = less --tabs 2 --mouse
[commit]
  gpgsign = true
[pull]
  rebase = false
[push]
  autoSetupRemote = true
  followTags = true
[init]
  defaultBranch = main
[tag]
  gpgSign = true
[gpg]
  program = /opt/homebrew/bin/gpg
[delta "catppuccin-dark"]
  syntax-theme = Catppuccin Mocha
	minus-style = "syntax #46242f"
	minus-emph-style = "syntax #682e3f"
	plus-style = "syntax #25402f"
	plus-emph-style = "syntax #2e5a3c"
